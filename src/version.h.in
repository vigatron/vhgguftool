/**
 * @file version.h
 * @brief Version information for vhgguftool.
 */

#ifndef VHGGUFTOOL_VERSION_H
#define VHGGUFTOOL_VERSION_H

#include <string>

#define VHGGUFTOOL_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define VHGGUFTOOL_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define VHGGUFTOOL_VERSION_PATCH @PROJECT_VERSION_PATCH@

#define VHGGUFTOOL_VERSION_HEX ( \
    (VHGGUFTOOL_VERSION_MAJOR * 10000) + \
    (VHGGUFTOOL_VERSION_MINOR * 100) + \
    (VHGGUFTOOL_VERSION_PATCH * 1) )

/**
 * @brief Возвращает строку версии программы.
 * @return Версия в формате MAJOR.MINOR.PATCH, например "0.2.0".
 */
inline std::string VHGetVersionString()
{
    return std::to_string(VHGGUFTOOL_VERSION_MAJOR) + "." +
           std::to_string(VHGGUFTOOL_VERSION_MINOR) + "." +
           std::to_string(VHGGUFTOOL_VERSION_PATCH);
}

#endif // VHGGUFTOOL_VERSION_H
